              height: 56,
              width: double.infinity,
              decoration: BoxDecoration(
                color: _isPaid
                    ? Colors.green.shade700
                    : KiranaColors.primary,
                borderRadius:
                    BorderRadius.circular(12),
              ),
              child: Row(
                mainAxisAlignment:
                    MainAxisAlignment.center,
                children: [
                  Icon(
                    _isPaid
                        ? Icons.check_circle_rounded
                        : Icons.payments_rounded,
                    color: Colors.white,
                    size: 20,
                  ),
                  const SizedBox(width: 10),
                  Text(
                    _isPaid
                        ? 'PAID'
                        : 'COLLECT CASH & MARK PAID →',
                    style: GoogleFonts.bebasNeue(
                      fontSize: 20,
                      color: Colors.white,
                      letterSpacing: 1.0,
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildDispatchButton(
    IconData icon,
    String title,
    String subtitle, {
    bool isSecondary = false,
  }) {
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: KiranaColors.surfaceContainer,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Row(
        children: [
          Container(
            width: 32,
            height: 32,
            decoration: BoxDecoration(
              color: isSecondary
                  ? KiranaColors.tertiaryFixed
                  : KiranaColors.surfaceContainerLowest,
              shape: BoxShape.circle,
            ),
            child: Icon(
              icon,
              size: 16,
              color: isSecondary
                  ? KiranaColors.onTertiaryContainer
                  : KiranaColors.onSurface,
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment:
                  CrossAxisAlignment.start,
              children: [
                Text(
                  title,
                  style: GoogleFonts.plusJakartaSans(
                    fontSize: 14,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                Text(
                  subtitle,
                  style: GoogleFonts.jetBrainsMono(
                    fontSize: 8,
                    color:
                        KiranaColors.onSurfaceVariant,
                  ),
                ),
              ],
            ),
          ),
          const Icon(
            Icons.chevron_right_rounded,
            size: 20,
            color: KiranaColors.onSurfaceVariant,
          ),
        ],
      ),
    );
  }

  Widget _buildCryptographicSeal(Invoice invoice) {
    final invoiceNumber = _invoiceNumber(invoice);
    final hash = _generateLocalHash(invoice);

    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: KiranaColors.surfaceContainerLow,
        borderRadius: BorderRadius.circular(16),
      ),
      child: Column(
        crossAxisAlignment:
            CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Icon(
                Icons.verified_user_rounded,
                size: 16,
                color: KiranaColors.onTertiaryContainer,
              ),
              const SizedBox(width: 8),
              Text(
                'LOCAL AUDIT LOG',
                style: GoogleFonts.jetBrainsMono(
                  fontSize: 9,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Text(
            'INVOICE: $invoiceNumber',
            style: GoogleFonts.jetBrainsMono(
              fontSize: 8,
              color: KiranaColors.onSurfaceVariant,
            ),
          ),
          Text(
            'LOCAL HASH: $hash',
            style: GoogleFonts.jetBrainsMono(
              fontSize: 8,
              color: KiranaColors.onSurfaceVariant,
            ),
          ),
          const SizedBox(height: 12),
          Wrap(
            spacing: 8,
            runSpacing: 4,
            children: [
              _buildSealTag('• GST DATA VALIDATED'),
              _buildSealTag('• OFFLINE READY'),
              _buildSealTag(
                _isPaid
                    ? '• PAYMENT SETTLED'
                    : '• PAYMENT PENDING',
              ),
            ],
          ),
        ],
      ),
    );
  }

  String _generateLocalHash(Invoice invoice) {
    final raw = [
      invoice.customerId ?? '',
      invoice.customerName ?? '',
      invoice.grandTotal.toStringAsFixed(2),
      ...invoice.items.map(
        (item) =>
            '${item.id}|${item.name}|${item.quantity}|'
            '${item.unitPrice}|${item.gstRate.percent}',
      ),
    ].join('|');

    return raw.hashCode.abs().toRadixString(16).padLeft(16, '0');
  }

  Widget _buildSealTag(String label) {
    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 6,
        vertical: 2,
      ),
      decoration: BoxDecoration(
        color: KiranaColors.surfaceContainer,
        borderRadius: BorderRadius.circular(4),
      ),
      child: Text(
        label,
        style: GoogleFonts.jetBrainsMono(
          fontSize: 8,
          fontWeight: FontWeight.bold,
        ),
      ),
    );
  }
}