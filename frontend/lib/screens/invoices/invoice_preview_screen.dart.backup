            ),
            child: Row(
              children: [
                Expanded(
                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment.start,
                    children: [
                      Text(
                        'Invoice Date',
                        style: GoogleFonts.jetBrainsMono(
                          fontSize: 9,
                          color: KiranaColors.onSurfaceVariant,
                        ),
                      ),
                      Text(
                        _formatDateTime(DateTime.now()),
                        style: GoogleFonts.jetBrainsMono(
                          fontSize: 10,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                    ],
                  ),
                ),
                Expanded(
                  child: Column(
                    crossAxisAlignment:
                        CrossAxisAlignment.start,
                    children: [
                      Text(
                        'Place of Supply',
                        style: GoogleFonts.jetBrainsMono(
                          fontSize: 9,
                          color: KiranaColors.onSurfaceVariant,
                        ),
                      ),
                      Text(
                        '27 - MAHARASHTRA (INTRA)',
                        style: GoogleFonts.jetBrainsMono(
                          fontSize: 10,
                          fontWeight: FontWeight.bold,
